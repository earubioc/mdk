{
  "name": "mdk-editor",
  "version": "2.9.0",
  "description": "MDK: editor de Markdown simple para Windows, identidad VDC Process Lab",
  "main": "main.js",
  "author": "Edgar A. Rubio C. / VDC Process Lab",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:installer": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vdcprocesslab.mdk",
    "productName": "MDK",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      { "provider": "github", "owner": "earubioc", "repo": "mdk" }
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Documento Markdown",
        "icon": "build/icon.ico"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "description": "Documento Markdown",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "MDK-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MDK-portable.exe"
    }
  }
}
